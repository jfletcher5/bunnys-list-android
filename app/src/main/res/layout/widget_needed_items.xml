<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="12dp">

    <!-- Header keeps the brand visible even on small widget sizes. -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bunnys_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_title"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_loading_text"
                android:textSize="12sp"
                android:textColor="#D4FFE2" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_primary"
            android:text="@string/widget_add"
            android:textColor="#0D3818"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_items_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/widget_header"
        android:layout_above="@id/widget_footer"
        android:layout_marginTop="10dp"
        android:divider="#2FFFFFFF"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_above="@id/widget_footer"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:text="@string/widget_empty_text"
        android:textColor="#E7FDEB"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/widget_refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_outline"
            android:text="@string/widget_refresh"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

</RelativeLayout>
